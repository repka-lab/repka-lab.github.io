    "site": "node src/site/build.ts",
    "site:preview": "node src/site/build.ts --drafts --out .preview/site"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "marked": "18.1.1",
    "typescript": "7.0.2"
  }
}
